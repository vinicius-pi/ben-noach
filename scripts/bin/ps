#!/bin/sh
# Tiny ps(1) so Lighthouse CI can query child PIDs in minimal containers.
# If a real procps `ps` exists, callers should prefer that on PATH.
ppid=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --ppid)
      ppid="$2"
      shift 2
      ;;
    --no-headers|-o|--pid)
      shift
      ;;
    *)
      shift
      ;;
  esac
done
if [ -n "$ppid" ] && [ -d "/proc/$ppid/task" ]; then
  for t in /proc/"$ppid"/task/*/children; do
    if [ -f "$t" ]; then
      # shellcheck disable=SC2013
      for child in $(cat "$t" 2>/dev/null); do
        echo "$child"
      done
    fi
  done
fi
exit 0
