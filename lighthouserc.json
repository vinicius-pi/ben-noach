{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec astro preview --host 127.0.0.1 --port 4173 --force",
      "startServerReadyPattern": "4173",
      "url": [
        "http://127.0.0.1:4173/ben-noach/en/",
        "http://127.0.0.1:4173/ben-noach/en/read/genesis/1/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci"
    }
  }
}
