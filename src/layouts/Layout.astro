---
import Mark from "../components/Mark.astro";
import SearchBox from "../islands/SearchBox";
import { localePath, t } from "../lib/i18n";
import type { Locale } from "../lib/types";
import "../styles/base.css";
import "../styles/chrome.css";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
  direction?: "editorial" | "scholarly" | "immersive";
}

const { locale, title, description, noindex = false, direction = "editorial" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = locale === "en" ? "pt" : "en";
const pathWithoutLocale =
  Astro.url.pathname.replace(new RegExp(`^${import.meta.env.BASE_URL}${locale}`), "") || "/";
---

<!doctype html>
<html lang={locale} dir="ltr" data-direction={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={direction === "immersive" ? "dark" : "light"} />
    <meta name="theme-color" content={direction === "immersive" ? "#0e1622" : "#fcfdfe"} />
    <meta name="description" content={description ?? t(locale, "tagline")} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={localePath(other, pathWithoutLocale)} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title} · {t(locale, "siteName")}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      {t(locale, "skip")}
    </a>
    <header class="site-header">
      <a class="brand" href={localePath(locale)}>
        <Mark />
        <span class="brand-name">{t(locale, "siteName")}</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav-links">
          <li>
            <a href={localePath(locale, "library")}>{t(locale, "library")}</a>
          </li>
          <li>
            <a href={localePath(locale, "paths")}>{t(locale, "paths")}</a>
          </li>
          <li>
            <a href={localePath(locale, "about")}>{t(locale, "about")}</a>
          </li>
          <li>
            <a href={localePath(other, pathWithoutLocale)} hreflang={other}>
              {other === "pt" ? "PT" : "EN"}
            </a>
          </li>
        </ul>
      </nav>
      <SearchBox client:idle locale={locale} />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(locale, "independent")}</p>
    </footer>
  </body>
</html>
