---
import Layout from "../../../layouts/Layout.astro";
import { GUIDED_PATHS } from "../../../lib/corpus";
import { localePath, t } from "../../../lib/i18n";
import type { Locale } from "../../../lib/types";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "pt" } }];
}

const locale = Astro.params.locale as Locale;
---

<Layout locale={locale} title={t(locale, "paths")}>
  <article class="reading">
    <p class="kicker">{t(locale, "paths")}</p>
    <h1 style="font-size:2.4rem;margin:0.4rem 0 2rem;font-weight:500">{t(locale, "homePaths")}</h1>
    <div class="stack">
      {GUIDED_PATHS.map((path) => (
        <a href={localePath(locale, `paths/${path.id}`)}>
          <strong>{locale === "pt" ? path.title.pt : path.title.en}</strong>
          <span class="meta-line">
            {" "}
            · {path.status === "partial" ? t(locale, "pathPartial") : t(locale, "pathPlanned")}
          </span>
          <p>{locale === "pt" ? path.summary.pt : path.summary.en}</p>
        </a>
      ))}
    </div>
  </article>
</Layout>
