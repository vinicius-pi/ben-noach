---
import Layout from "../../../layouts/Layout.astro";
import { GUIDED_PATHS, VERSES } from "../../../lib/corpus";
import { localePath, t } from "../../../lib/i18n";
import type { Locale } from "../../../lib/types";

export function getStaticPaths() {
  return (["en", "pt"] as const).flatMap((locale) =>
    GUIDED_PATHS.map((path) => ({ params: { locale, id: path.id } })),
  );
}

const locale = Astro.params.locale as Locale;
const path = GUIDED_PATHS.find((item) => item.id === Astro.params.id);
if (!path) return new Response("Not found", { status: 404 });
---

<Layout locale={locale} title={locale === "pt" ? path.title.pt : path.title.en}>
  <article class="reading">
    <p class="kicker">{t(locale, "paths")}</p>
    <h1 class="page-title-sm">{locale === "pt" ? path.title.pt : path.title.en}</h1>
    <p>{locale === "pt" ? path.summary.pt : path.summary.en}</p>
    {path.steps.length === 0 ? (
      <p class="meta-line planned-note">{t(locale, "pathPlanned")}</p>
    ) : (
      <ol class="step-list">
        {path.steps.map((step, index) => {
          const verse = VERSES.find((item) => item.id === step.verseId);
          if (!verse) return null;
          return (
            <li>
              <a
                href={`${localePath(locale, `read/${verse.canonicalRef.bookId}/${verse.canonicalRef.chapter}`)}#v${verse.canonicalRef.verse}`}
              >
                {index + 1}. {locale === "pt" ? step.label.pt : step.label.en}
                <span class="meta-line"> · {verse.canonicalRef.display[locale]}</span>
              </a>
            </li>
          );
        })}
      </ol>
    )}
  </article>
</Layout>
