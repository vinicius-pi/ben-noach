---
import Layout from "../../layouts/Layout.astro";
import { BOOKS } from "../../lib/corpus";
import { LOCALES, localePath, t } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const groups = [
  { id: "torah", title: t(locale, "torah") },
  { id: "neviim", title: t(locale, "neviim") },
  { id: "ketuvim", title: t(locale, "ketuvim") },
] as const;
---

<Layout locale={locale} title={t(locale, "library")}>
  <article class="reading">
    <p class="kicker">{t(locale, "library")}</p>
    <h1 class="page-title">{t(locale, "library")}</h1>
    {groups.map((group) => (
      <section id={group.id} class="library-group">
        <h2 class="kicker">{group.title}</h2>
        <ul class="plain-list">
          {BOOKS.filter((book) => book.division === group.id).map((book) => (
            <li>
              <a
                href={
                  book.releasedChapters[0]
                    ? localePath(locale, `read/${book.id}/${book.releasedChapters[0]}`)
                    : localePath(locale, "library")
                }
              >
                <span class="hebrew" lang="he" dir="rtl">
                  {book.titles.he}
                </span>
                {" · "}
                {locale === "pt" ? book.titles.pt : book.titles.en}
                {" · "}
                {book.titles.transliteration}
                {!book.releasedChapters.length && (
                  <span class="meta-line"> — {t(locale, "emptyLibrary")}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>
