---
import Layout from "../../layouts/Layout.astro";
import ReaderApp from "../../islands/ReaderApp";
import { buildReaderPayload } from "../../lib/corpus";

export function getStaticPaths() {
  return [
    { params: { direction: "editorial" } },
    { params: { direction: "scholarly" } },
    { params: { direction: "immersive" } },
  ];
}

const direction = Astro.params.direction as "editorial" | "scholarly" | "immersive";
const payload = buildReaderPayload("en", "genesis", 1);
if (!payload) throw new Error("Missing genesis payload");
---

<Layout locale="en" title={`Direction: ${direction}`} noindex direction={direction}>
  <p class="kicker" style="padding:0 var(--gutter)">
    {direction}
  </p>
  <ReaderApp client:load payload={payload} direction={direction} />
</Layout>
