---
import Layout from "../../layouts/Layout.astro";
import genesis from "../../data/verses.json";

const samples = genesis.slice(0, 5) as {
  canonicalRef: { display: { en: string } };
  hebrew: { text: string };
  translation: { text: string };
}[];
const families = [
  { name: "Frank Ruhl Libre", className: "he-frank" },
  { name: "Noto Serif Hebrew", className: "he-noto" },
];
---

<Layout locale="en" title="Typography proof" noindex>
  <article class="reading">
    <p class="kicker">Design</p>
    <h1 style="font-size:2rem;font-weight:500;margin:0.4rem 0 1rem">Type proof</h1>
    <p>
      Same verses, two Hebrew families, several sizes. Choose by diacritics, not by brand
      familiarity.
    </p>
    {families.map((family) => (
      <section style="margin-top:2.5rem">
        <h2 class="kicker">{family.name}</h2>
        {[1, 1.25, 1.6].map((scale) => (
          <div style={`margin-top:1.2rem;font-size:${scale}rem`}>
            {samples.map((verse) => (
              <p
                class:list={["hebrew", family.className]}
                lang="he"
                dir="rtl"
                style="margin:0.4rem 0"
              >
                {verse.hebrew.text}
              </p>
            ))}
            <p class="latin" lang="en" dir="ltr" style="margin-top:0.6rem">
              {samples[0]?.translation.text}
            </p>
          </div>
        ))}
      </section>
    ))}
  </article>
</Layout>
<style>
  .he-frank {
    font-family: "Frank Ruhl Libre", serif;
  }
  .he-noto {
    font-family: "Noto Serif Hebrew", serif;
  }
</style>
