{
  "name": "ben-noach",
  "version": "0.1.0",
  "private": true,
  "description": "A guided Tanakh reader for Bnei Noach: READ → UNDERSTAND → SOURCES.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/reader.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:licenses": "tsx scripts/validate-licenses.ts",
    "validate:providers": "tsx scripts/validate-providers.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "scan:osv": "tsx scripts/scan-osv.ts",
    "corpus:generate": "python scripts/generate-corpus.py",
    "lhci": "lhci autorun",
    "qa": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm validate:content && pnpm validate:licenses && pnpm validate:providers && pnpm scan:secrets && pnpm build"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "astro": "7.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
